{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PadLend",
  "version": "1.1.0",
  "identifier": "com.padlend.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../frontend-dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PadLend",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/padlend-service"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../vendor/scrcpy-server-v5.0.1.jar": "vendor/scrcpy-server-v5.0.1.jar",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../LICENSES/Apache-2.0.txt": "LICENSES/Apache-2.0.txt",
      "../LICENSES/BSD-3-Clause-psutil.txt": "LICENSES/BSD-3-Clause-psutil.txt",
      "../LICENSES/MIT-PyYAML.txt": "LICENSES/MIT-PyYAML.txt",
      "../LICENSES/PyInstaller-COPYING.txt": "LICENSES/PyInstaller-COPYING.txt",
      "../LICENSES/Python-3.13-PSF.txt": "LICENSES/Python-3.13-PSF.txt",
      "../LICENSES/adb-NOTICE.txt": "LICENSES/adb-NOTICE.txt"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
